{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-as-code.local/schemas/claim-manifest.schema.json",
  "title": "Resume claim provenance manifest",
  "type": "object",
  "required": ["schema_version", "application", "claims", "open_questions"],
  "properties": {
    "schema_version": {"const": 1},
    "application": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["resume_path", "output", "sources", "transformations", "handling", "unsupported_additions"],
        "properties": {
          "resume_path": {"type": "string", "pattern": "^cv\\."},
          "output": {"type": "string", "minLength": 1},
          "sources": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["record", "claim"],
              "properties": {
                "record": {"type": "string", "minLength": 1},
                "claim": {"type": "string", "minLength": 1}
              },
              "additionalProperties": false
            }
          },
          "transformations": {
            "type": "array",
            "items": {"enum": ["verbatim", "condensed", "combined", "translated", "tailored"]},
            "uniqueItems": true
          },
          "handling": {"enum": ["verified", "conservative", "needs-confirmation"]},
          "unsupported_additions": {"type": "array", "maxItems": 0},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "open_questions": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
