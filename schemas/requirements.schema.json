{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-as-code.local/schemas/requirements.schema.json",
  "title": "Structured job analysis",
  "type": "object",
  "required": [
    "schema_version", "company", "role", "language", "source",
    "responsibilities", "required_skills", "preferred_skills", "technologies",
    "domains", "competencies", "seniority_signals", "keywords", "constraints",
    "inferred_requirements"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "company": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 2},
    "source": {"const": "job-description.md"},
    "responsibilities": {"$ref": "#/$defs/stringList"},
    "required_skills": {"$ref": "#/$defs/stringList"},
    "preferred_skills": {"$ref": "#/$defs/stringList"},
    "technologies": {"$ref": "#/$defs/stringList"},
    "domains": {"$ref": "#/$defs/stringList"},
    "competencies": {"$ref": "#/$defs/stringList"},
    "seniority_signals": {"$ref": "#/$defs/stringList"},
    "keywords": {"$ref": "#/$defs/stringList"},
    "constraints": {"$ref": "#/$defs/stringList"},
    "inferred_requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["requirement", "basis"],
        "properties": {
          "requirement": {"type": "string", "minLength": 1},
          "basis": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stringList": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true
    }
  }
}
