{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://resume-as-code.local/schemas/record.schema.json",
  "title": "Career knowledge record frontmatter",
  "type": "object",
  "required": ["id", "type", "title", "visibility", "verification"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "type": {
      "enum": ["company", "role", "project", "initiative", "decision", "incident", "achievement", "knowledge", "evidence"]
    },
    "title": {"type": "string", "minLength": 1},
    "company": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "project": {"type": "string", "minLength": 1},
    "start_date": {"$ref": "#/$defs/date"},
    "end_date": {"oneOf": [{"$ref": "#/$defs/date"}, {"type": "null"}]},
    "technologies": {"$ref": "#/$defs/stringSet"},
    "domains": {"$ref": "#/$defs/stringSet"},
    "competencies": {"$ref": "#/$defs/stringSet"},
    "seniority_signals": {"$ref": "#/$defs/stringSet"},
    "tags": {"$ref": "#/$defs/stringSet"},
    "visibility": {"enum": ["public", "internal", "private"]},
    "verification": {"enum": ["verified", "user-supplied", "needs-confirmation"]},
    "related_records": {"$ref": "#/$defs/stringSet"},
    "claims": {
      "type": "array",
      "items": {"$ref": "#/$defs/claim"}
    }
  },
  "additionalProperties": true,
  "$defs": {
    "date": {
      "type": ["string", "integer"],
      "pattern": "^\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?$"
    },
    "stringSet": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "uniqueItems": true,
      "default": []
    },
    "claim": {
      "type": "object",
      "required": ["id", "statement", "visibility", "confidence", "safe_to_paraphrase", "evidence"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "statement": {"type": "string", "minLength": 1},
        "visibility": {"enum": ["public", "internal", "private"]},
        "confidence": {"enum": ["verified", "approximate", "user-supplied", "needs-confirmation"]},
        "safe_to_paraphrase": {"type": "boolean"},
        "exact_wording_required": {"type": "boolean", "default": false},
        "evidence": {"$ref": "#/$defs/stringSet"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"confidence": {"const": "verified"}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        }
      ]
    }
  }
}
