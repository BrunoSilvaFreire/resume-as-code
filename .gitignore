.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
.DS_Store
*.log

# RenderCV's default output folder; application PDFs use explicit paths and are tracked.
rendercv_output/

# Legacy per-user data remains ignored.
data/resumes/
data/interviews/
data/timeline/
data/drafts/
data/.cache/
data/profiles/*
!data/profiles/*.example.yml

# Optional local agent adapters.
.claude/skills/
.cursor/rules/resume-as-code.mdc
.windsurf/rules/resume-as-code.md
.clinerules

# Personal career data. Only the scaffolding READMEs ship; real records and the
# generated index stay local. Start from examples/demo/ or `career new-record`.
/career/*
!/career/README.md
!/career/profile/
/career/profile/*
!/career/profile/README.md

# Personal job applications. Only the scaffolding README ships.
/applications/*
!/applications/README.md

# Job-search runs contain personal shortlists and saved-job ids. Keep the
# workflow README and the reusable platform research.
/job-search/*
!/job-search/README.md
!/job-search/2026-10-12-external-platforms.md

# Agent working state (personal logs, todos, scratch investigation notes).
/.opencode/context.md
/.opencode/todo.md
/.opencode/todo.version.json
/.opencode/work-log.md
/.opencode/status.md
/.opencode/unit-tests/
/.opencode/docs/
/docs/investigation/
