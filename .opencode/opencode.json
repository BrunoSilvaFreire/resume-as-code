{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "linkedin": {
        "type": "local",
        "command": [
          "uvx",
          "--from",
          "git+https://github.com/satyalyadav/linkedin-mcp-server@feature/724-unsave",
          "mcp-server-linkedin"
        ],
        "environment": {
          "UV_HTTP_TIMEOUT": "300"
        }
      }
    }
  }
}
